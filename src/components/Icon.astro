const isBrand = name in fill;
const markup = isBrand ? fill[name as keyof typeof fill] : stroke[name as keyof typeof stroke];
---

{
    isBrand ? (
        <svg class= {className} viewBox = "0 0 24 24" fill="currentColor" aria-hidden="true" set:html={markup}
        />
    ) : (
        <svg class= {className} viewBox = "0 0 24 24" fill="currentColor" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" set:html={markup}
        />
    )
}