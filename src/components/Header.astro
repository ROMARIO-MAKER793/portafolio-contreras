---
import {site} from "../data/site.js";
import { ThemeToogle } from "./ThemeToogle.astro";
import Icon from "./Icon.astro";
---

<header id="site-header" class="fixed insert-x-0 top-0 -z-50 border-b border-transparent bg-canvas/85 backdrop-blur-md transition-colors duration-300">
    <div class="mx-auto flex h-16 w-full max-w-6xl items-center justify-between px-6">
        <a href="/" class="flex items-center gap-2.5 font-display text-sm font-bold tracking-tight">
                <span>{site.initials}</span>
            <span>{site.name}</span>
        </a>
    </div>
</header>