---
import { site } from '../data/site.js';
import Icon from './Icon.astro';
---

<section id= "Inicio" class="relative overflow-hidden pt-32 pb-16 sm:pt-40 sm:pb:24">
    <div class="blueprint pointer-events-none absolute inset-0 -z-10" aria-hidden="true"></div>
    <div class="mx-auto grid w-full max-w-6xl items-end gap-12 px-6 lg:grid-cols-12">
        <div class="lg:col-span-7">
             {site.available && (
                <p>
                    <span class="status-dot"></span>
                    <span>{site.availableText}</span>
                </p>
             )}

             <h1 class="enter nt-6 font-display text-5xl leading-[0.95] font-bold sm:text-6xl lg:text-7xl" 
             style="--delay: 90ms">{site.name}</h1>

             <p class="enter mt-4 font-display text-xl text-accent sm:text-2xl"
             style="--delay: 170ms">{site.role}</p>

             <p class="enter mt-6 max-w-[54ch] text-base leading-relaxed text-muted sm:text-lg"
             style="--delay: 250ms">{site.intro}</p>

             <div>
                <a href="#proyecto" class=" inline-flex items-center gap-2 rounded-full bg-ink 
                px-5 py-3 text-sm font-medium text-canvas transition duration-300 hover:-translate-y-0.5 hover:bg-accent"
                >Ver proyectos
            <Icon name="arrow-right" class="h-4 w-4 transition-transform duration-300 group-hover:translate-x-1" />
        </a>
                
                <a href="#contacto" class="inline-flex  items-center gap-2 rounded-full bg-ink 
                px-5 py-3 text-sm font-medium text-canvas transition duration-300 
                hover:-translate-y-0.5 hover:bg-accent">
                <Icon name="mail" class="h-4 w-4" /> Escríbeme</a>
             </div>
        </div>
    </div>

    <aside>
        <dl class="divide-y divide-inline rounde-2xl border border-line bg-surface/70 p-6 backdrop:blur">
            <div class="flex items-start justify-between gap-6 pb-4">
                <dt class=" text-sm text-muted">Dónde</dt>
                <dd class="flex items-center gap-2 text-right text-sm font-medium">
                    <Icon name="pin" class="h-4 w-4 text-accent" />
                    {site.location}</dd>
            </div>
        </dl>
    </aside>
        
</section>