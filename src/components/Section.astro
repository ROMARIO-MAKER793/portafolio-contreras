---
const {id, title, lead} = Astro.props;
---

<section id={id} class="border-t border-line py-20 sm:py-28">
    <div class="mx-auto grid w-full max-w-6xl gap-10 px-6 lg:grid-col-[15rem_fr] lg:gap-16">
        <div>
            <h2>{title}</h2>
            {
                lead &&(
                    <p class="reveal mt-5 max-w-[38ch] text-sm leading-relaxed text-muted"
                    style="--delay: 80ms"
                    >
                        {lead}
                    </p>
                )          
            }
        </div>
        <div>
            <slot />
        </div>
    </div>
</section>